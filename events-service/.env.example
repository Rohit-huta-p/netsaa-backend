# events-service — PAYMENTS / Cashfree configuration.
# This documents the event money-layer env vars (and the few the server needs to boot). It is
# NOT an exhaustive list of every events-service variable.

# ─── Core / DB (required to boot) ─────────────────────────────────────────────
NODE_ENV=development
PORT=5003
# The server connects with EVENTS_MONGO_URI (migrations also accept MONGO_URI as a fallback).
EVENTS_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/netsa-events?retryWrites=true&w=majority

# ─── Payments (event money layer) ────────────────────────────────────────────
# Provider selector. Controllers import `payments` from services/payments. cashfree is the
# finalized provider; razorpay is the rollback.
PAYMENT_PROVIDER=cashfree

# ⭐ EVENTS_PAYMENTS_MOCK — DELIBERATE PRODUCTION MOCK SWITCH.
# Set to 1 in production to let paid event registration complete END-TO-END through the mock
# (faked Cashfree responses + the POST /v1/reservations/:orderId/dev-confirm endpoint) while
# Cashfree is NOT yet live-activated. With it ON, NO real order, charge, split or payout is ever
# created — no money is collected.
# NOTE: the mock also fakes the rest of the stack — vendor onboarding returns "verified", UPI/bank
# verification is faked, and refunds return SUCCESS. Organizer payout accounts and paid
# registrations created under the mock persist after the flag is turned off.
# Flip it OFF (unset, or 0) to go live once Cashfree is activated. Equivalent to CASHFREE_DEV_MODE;
# this name exists so the prod switch is explicit and not mistaken for a dev-only backdoor.
EVENTS_PAYMENTS_MOCK=0

# CASHFREE_DEV_MODE — original dev / CI / no-credentials mock flag. Same effect as
# EVENTS_PAYMENTS_MOCK. Leave unset in prod; set to 1 for local dev without Cashfree creds.
CASHFREE_DEV_MODE=0

# Cashfree Easy Split (PG + split) + Secure ID (VRS) credentials. Required when the mock is OFF.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
CASHFREE_API_VERSION=2026-01-01
CASHFREE_VRS_API_VERSION=2024-12-01

# Legacy Razorpay (rollback provider only — set PAYMENT_PROVIDER=razorpay to use).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Auto-verify payout accounts without a real KYC round-trip (local/dev only).
PAYOUTS_DEV_AUTOVERIFY=0

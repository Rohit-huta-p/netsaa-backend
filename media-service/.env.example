# ============================================================
# MEDIA-SERVICE ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------
NODE_ENV=development
PORT=4005
SERVICE_NAME=media-service

# ------------------------------------------------------------
# MONGODB
# ------------------------------------------------------------
# Connection string to MongoDB Atlas (shared across services)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/netsa?retryWrites=true&w=majority

# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------
# Must match the secret used by users-service
JWT_SECRET=

# ------------------------------------------------------------
# AWS S3 CONFIGURATION
# ------------------------------------------------------------
# IAM credentials with limited S3 permissions (PutObject, GetObject)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region for S3 bucket
AWS_REGION=ap-south-1

# S3 bucket name (environment-specific)
# dev:     netsa-media-dev
# staging: netsa-media-staging
# prod:    netsa-media-prod
AWS_S3_BUCKET=netsa-media-dev

# ------------------------------------------------------------
# MUX (VIDEO)  — https://dashboard.mux.com/settings/access-tokens
# ------------------------------------------------------------
# Access token with Mux Video Read+Write permission (environment-scoped).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing secret of the webhook created at Mux Settings → Webhooks
# (endpoint URL: <public-base>/v1/media/webhooks/mux). Unique per endpoint.
# OPTIONAL for local dev: leave empty → webhooks are rejected and video status
# resolves via the getAssetStatus Mux poll-fallback (no ngrok needed). Set in staging/prod.
MUX_WEBHOOK_SECRET=

# ------------------------------------------------------------
# SERVICE-TO-SERVICE (media → events attach)
# ------------------------------------------------------------
# Shared secret for the internal attach call. Generate: openssl rand -hex 32
# MUST equal events-service's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=
# Base URL of events-service. Local dev runs on :5010 (NOT :5003 = search-service).
# In prod, set the deployed events-service URL.
EVENTS_SERVICE_URL=http://localhost:5010

# ------------------------------------------------------------
# CDN CONFIGURATION (Optional)
# ------------------------------------------------------------
# CloudFront distribution URL (leave empty for development)
# Example: https://d1234567890.cloudfront.net
CDN_BASE_URL=

# ------------------------------------------------------------
# UPLOAD CONFIGURATION
# ------------------------------------------------------------
# Pre-signed URL expiry in seconds (default: 10 minutes)
PRESIGN_EXPIRY_SECONDS=600

# ------------------------------------------------------------
# FILE SIZE LIMITS (in bytes)
# ------------------------------------------------------------
# These override default limits per file type
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=104857600
MAX_DOCUMENT_SIZE_BYTES=20971520

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated list of allowed origins (use * for development)
CORS_ORIGINS=*
